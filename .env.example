# Gabarit des variables de docker compose. Commité.
# Copier en `.env` à la racine et remplacer les valeurs :
#     cp .env.example .env

# Signe les JWT Mercure, côté publieur comme côté abonné. 32 caractères minimum.
MERCURE_JWT_SECRET=changez-moi-32-caracteres-minimum-en-local

# UID/GID de l'utilisateur hôte, propagés à `www-data` dans l'image backend.
# Sans cela, les fichiers écrits par le conteneur dans le bind mount
# (var/cache, var/log, vendor/) appartiendraient à root sur l'hôte.
#     echo "USER_ID=$(id -u)" >> .env && echo "GROUP_ID=$(id -g)" >> .env
USER_ID=1000
GROUP_ID=1000

# Stockage objet. `INTERNAL` sert aux appels serveur (worker, purge) ;
# `PUBLIC` sert UNIQUEMENT a signer les URLs que le navigateur ouvrira.
# Une URL pre-signee signe le Host : signer avec `minio:9000` puis appeler
# `localhost:8080` rendrait `SignatureDoesNotMatch` (spec §5.1).
MEDIA_BUCKET=messaging-media
MEDIA_S3_INTERNAL_ENDPOINT=http://minio:9000
MEDIA_S3_PUBLIC_ENDPOINT=http://localhost:8080
MEDIA_S3_KEY=minioadmin
MEDIA_S3_SECRET=minioadmin

MESSENGER_TRANSPORT_DSN=amqp://app:app@rabbitmq:5672/%2f
