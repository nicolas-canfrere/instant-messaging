# Gabarit des variables de docker compose. Commité.
# Copier en `.env` à la racine et remplacer les valeurs :
#     cp .env.example .env

# Signe les JWT Mercure, côté publieur comme côté abonné. 32 caractères minimum.
MERCURE_JWT_SECRET=changez-moi-32-caracteres-minimum-en-local

# UID/GID de l'utilisateur hôte, propagés à `www-data` dans l'image backend.
# Sans cela, les fichiers écrits par le conteneur dans le bind mount
# (var/cache, var/log, vendor/) appartiendraient à root sur l'hôte.
#     echo "USER_ID=$(id -u)" >> .env && echo "GROUP_ID=$(id -g)" >> .env
USER_ID=1000
GROUP_ID=1000
